# VansGo — Go backend + SPA
# cp .env.example .env; set INITIAL_PASSWORD; docker compose up -d
# The default image below is ARM64 and the tag is mutable. For AMD64, build
# locally and use VANSGO_IMAGE=vansgo:go-local.
VANSGO_IMAGE=ghcr.io/zanonaa/vansgo:dev-go-arm64

# Address and port PUBLISHED by Compose. Go listens on 20128 inside the container.
BIND_ADDRESS=127.0.0.1
PORT=20128

# Initial password for new installs only. Replace with a strong value.
INITIAL_PASSWORD=
NODE_ENV=production

# Docker: keep /app/data and preserve the existing volume.
# Native runs: set an absolute path of your choice.
DATA_DIR=/app/data
# SPA_DIR is /app/spa in the image. Native runs: path to frontend/dist.
# SPA_DIR=/path/to/frontend/dist

# Omitted/empty: generated secrets are persisted under DATA_DIR.
JWT_SECRET=
API_KEY_SECRET=
# Enable when the dashboard is served behind HTTPS.
AUTH_COOKIE_SECURE=false

# Optional Headroom: docker compose --profile headroom up -d
# Also enable the integration in the dashboard. RTK is independent of it.
HEADROOM_URL=http://headroom:8787
HEADROOM_PORT=8787

# Diagnostics: turn the Tool Call Guard off globally if needed.
# VANSGO_TOOL_GUARD=off
# Data protection: temporary DATA_DIR is refused in production unless opted in.
# DATA_DIR_ALLOW_TEMP=1

# Outbound HTTP proxy (optional; per-connection settings live in the dashboard).
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080
# NO_PROXY=localhost,127.0.0.1
